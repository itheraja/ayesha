# Default is real embedded PostgreSQL for local synthetic-data demonstrations.
DATABASE_MODE=local
# For Supabase set DATABASE_MODE=supabase and use its PostgreSQL connection URI.
# Use the session pooler on IPv4-only networks. Never expose this in NEXT_PUBLIC_*.
DATABASE_URL=
OPENAI_API_KEY=
LIVE_VOICE=gleam
# Optional prompt-generated voice ID; no real-person cloning.
LIVE_CUSTOM_VOICE_ID=
BACKEND_MODEL=gpt-6-luna
ADMIN_PASSWORD=
# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
MAX_CALL_SECONDS=600
MAX_DEMO_SESSIONS=60
BUDGET_WARNING_USD=15
BUDGET_LIMIT_USD=20
VOICE_USD_PER_MINUTE=0.05
# Set these from the current pricing for your backend model; zero means unknown.
BACKEND_INPUT_USD_PER_MILLION=0
BACKEND_OUTPUT_USD_PER_MILLION=0
